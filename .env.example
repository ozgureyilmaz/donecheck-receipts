# Copy to .env and fill in. Never commit .env.
# Official Meta Model API variable name (per dev.meta.ai/docs/authentication):
MODEL_API_KEY=
# Optional alias: code falls back to META_API_KEY if MODEL_API_KEY is unset.
# META_API_KEY=

META_API_BASE=https://api.meta.ai/v1
RECEIPTS_AGENT_MODEL=muse-wonder-1.0
RECEIPTS_JUDGE_MODEL=muse-spark-1.3
RECEIPTS_SAM_MODEL=sam-3.1

MOCKSITE_HOST=127.0.0.1
MOCKSITE_PORT=8000
RECEIPTS_DB=runs/receipts.sqlite
RECEIPTS_MAX_STEPS=40
